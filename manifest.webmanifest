{
  "id": "./",
  "name": "Ripped Kitchen",
  "short_name": "Ripped Kitchen",
  "description": "Nutrition, meal prep, training and physique progress dashboard.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "portrait-primary",
  "background_color": "#0b0f14",
